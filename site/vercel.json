{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd .. && ELECTRON_SKIP_BINARY_DOWNLOAD=1 pnpm install --frozen-lockfile",
  "buildCommand": "cd .. && pnpm build:site && rm -rf site/out && cp -r out-site site/out",
  "outputDirectory": "out",
  "cleanUrls": true
}
