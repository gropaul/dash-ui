<node id="stations" type="query" x="460" y="0" width="400" height="160">

```sql stations
-- view: select
-- column: StationName
SELECT * FROM trains
```

</node>

<node id="types" type="query" x="480" y="200" width="400" height="440">

```sql types_of_trains
-- view: table
SELECT ServiceType, count(DISTINCT TrainNumber) AS num_trains
FROM refs.stations()
GROUP BY ALL
ORDER BY num_trains DESC
```

</node>

<node id="total" type="query" x="920" y="0" width="300" height="160" code="hidden">

```sql total_trains
-- view: text
SELECT format('{:,}', sum(num_trains)) AS total_trains, 'trains through the picked stations' AS detail
FROM refs.types_of_trains()
```

</node>

<node id="chart" type="query" x="920" y="200" width="400" height="440" code="hidden">

```sql types_bar_chart
-- view: bar
-- x: ServiceType
-- y: num_trains
-- settings: {"chart": {"plot": {"cartesian": {"xLabelRotation": 45}}}}
SELECT * FROM refs.types_of_trains()
```

</node>
