DuckDB extension

</node>

<node id="stations" type="query" x="460" y="0" width="400" height="220">

```sql stations
-- view: select
-- column: StationName
SELECT StationName, count(DISTINCT TrainNumber) AS num_trains
FROM 'https://raw.githubusercontent.com/gropaul/dash-ui/main/test/data/services-2025-38.parquet'
GROUP BY ALL
ORDER BY num_trains DESC
```

</node>

<node id="types" type="query" x="510" y="250" width="400" height="440">

```sql types_of_trains
-- view: table
SELECT ServiceType, count(DISTINCT TrainNumber) AS num_trains
FROM 'https://raw.githubusercontent.com/gropaul/dash-ui/main/test/data/services-2025-38.parquet'
WHERE StationName IN (SELECT StationName FROM refs.stations())
GROUP BY ALL
ORDER BY num_trains DESC
```

</node>

<node id="total" type="query" x="960" y="30" width="300" height="170" code="hidden">

```sql total_trains
-- view: text
SELECT format('{:,}', sum(num_trains)) AS total_trains, 'trains through the picked stations' AS detail
FROM refs.types_of_trains()
```

</node>

<node id="chart" type="query" x="940" y="250" width="360" height="440" code="hidden">

```sql types_bar_chart
-- view: bar
-- x: ServiceType
-- y: num_trains
SELECT * FROM refs.types_of_trains()
```

</node>
