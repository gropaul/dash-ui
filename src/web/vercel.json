{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && ELECTRON_SKIP_BINARY_DOWNLOAD=1 pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm build:web",
  "outputDirectory": "out",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/duckdb-dashboard",
      "destination": "/dashboard-with-duckdb",
      "permanent": true
    }
  ]
}
