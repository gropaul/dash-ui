# Flat node_modules (npm-style) instead of pnpm's symlinked .pnpm store.
#
# Required for electron-builder to package the native DuckDB (neo) backend: its
# transitive chain (@duckdb/node-api -> @duckdb/node-bindings ->
# @duckdb/node-bindings-darwin-arm64, plus detect-libc) otherwise lives only under
# node_modules/.pnpm, a dot-directory that electron-builder's file globber skips.
# Hoisting puts the whole chain at top-level node_modules where it can be collected
# and the native *.node binary unpacked from the asar.
node-linker=hoisted
